<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F4F7FB">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
<TextView android:text="V100 FOOTBALL AI" android:textSize="25sp" android:textStyle="bold" android:textColor="#0B1220" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:text="AI Football Intelligence Platform" android:textSize="14sp" android:textColor="#536273" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp"/>
<TextView android:id="@+id/status" android:text="System ready • Demo data" android:textStyle="bold" android:textColor="#1565C0" android:background="#E8F1FF" android:padding="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<Button android:id="@+id/scan" android:text="SCAN TODAY'S FIXTURES" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp"/>
<TextView android:id="@+id/matches" android:text="\nMatches\nNo fixtures scanned yet." android:textSize="17sp" android:textColor="#172033" android:background="#FFFFFF" android:padding="16dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp"/>
<Button android:id="@+id/builder" android:text="OPEN BET BUILDER" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp"/>
<TextView android:id="@+id/output" android:text="\nBet Builder\nChoose a fixture after scanning.\n\nSafe • Balanced • High Odds\nGoals • Corners • Cards • Result" android:textSize="16sp" android:textColor="#172033" android:background="#FFFFFF" android:padding="16dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp"/>
<TextView android:text="\nV100 MODULES\n• Smart Match Scanner\n• Statistical & Historical Engine\n• Player Intelligence\n• Multi-Model Predictions\n• Correlation & Risk Engine\n• Odds & Value Engine\n• Back-testing Lab\n• Live Intelligence\n• Results & Performance Center\n\nNote: This build uses demo data. Connect a licensed football-data/odds API before relying on live information." android:textSize="15sp" android:textColor="#172033" android:background="#FFFFFF" android:padding="16dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp"/>
</LinearLayout></ScrollView>
